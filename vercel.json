{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/css/(.*)", "dest": "frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "frontend/js/$1" },
    { "src": "/login.html", "dest": "frontend/login.html" },
    { "src": "/(.*\\.ico)", "dest": "frontend/$1" },
    { "src": "^/$", "dest": "frontend/index.html" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
